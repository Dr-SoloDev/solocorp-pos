generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  VIEWER
}

enum ItemCondition {
  GOOD
  FAIR
  POOR
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

enum TransactionType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  PROMPTPAY
  BANK_TRANSFER
  CREDIT_CARD
  QR_CODE
}

// ─── USERS & AUTH ───────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  role          UserRole  @default(CASHIER)
  phone         String?
  isActive      Boolean   @default(true)
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  purchaseOrders PurchaseOrder[]
  saleOrders    SaleOrder[]
  createdLots   Lot[]
  adjustments   InventoryAdjustment[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── BRANCHES ───────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  lots      Lot[]

  @@map("branches")
}

// ─── CATEGORIES & PRODUCTS ──────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  description String?
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id           String        @id @default(cuid())
  name         String
  barcode      String?       @unique
  sku          String?       @unique
  description  String?
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id])
  unit         String        @default("ชิ้น")
  buyPrice     Decimal?      @db.Decimal(10, 2)
  sellPrice    Decimal?      @db.Decimal(10, 2)
  minStock     Int           @default(0)
  maxStock     Int?
  isActive     Boolean       @default(true)
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lots         Lot[]
  purchaseItems PurchaseItem[]
  saleItems    SaleItem[]

  @@map("products")
}

// ─── INVENTORY (LOT TRACKING) ───────────────────────────

model Lot {
  id             String          @id @default(cuid())
  lotCode        String
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id])
  quantity       Int             @default(0)
  availableQty   Int             @default(0)
  condition      ItemCondition   @default(GOOD)
  buyPrice       Decimal?        @db.Decimal(10, 2)
  sellPrice      Decimal?        @db.Decimal(10, 2)
  purchaseDate   DateTime?
  expiryDate     DateTime?
  location       String?
  notes          String?
  isActive       Boolean         @default(true)
  createdById    String?
  createdBy      User?           @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  adjustments    InventoryAdjustment[]

  @@unique([lotCode, branchId])
  @@map("lots")
}

// ─── PURCHASE (รับซื้อ) ──────────────────────────────────

model PurchaseOrder {
  id            String        @id @default(cuid())
  orderCode     String        @unique
  sellerName    String?
  sellerPhone   String?
  sellerIdCard  String?
  sellerAddress String?
  totalAmount   Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  netAmount     Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  status        String        @default("COMPLETED")  // DRAFT, COMPLETED, CANCELLED
  notes         String?
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         PurchaseItem[]

  @@map("purchase_orders")
}

model PurchaseItem {
  id          String        @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  lotId       String?
  lot         Lot?          @relation(fields: [lotId], references: [id])
  quantity    Int
  unitPrice   Decimal       @db.Decimal(10, 2)
  totalPrice  Decimal       @db.Decimal(12, 2)
  condition   ItemCondition @default(GOOD)
  notes       String?

  @@map("purchase_items")
}

// ─── SALE (ขาย) ─────────────────────────────────────────

model SaleOrder {
  id            String        @id @default(cuid())
  orderCode     String        @unique
  customerName  String?
  customerPhone String?
  totalAmount   Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  netAmount     Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  status        String        @default("COMPLETED")  // DRAFT, COMPLETED, CANCELLED
  notes         String?
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         SaleItem[]

  @@map("sale_orders")
}

model SaleItem {
  id          String     @id @default(cuid())
  orderId     String
  order       SaleOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  lotId       String?
  lot         Lot?       @relation(fields: [lotId], references: [id])
  quantity    Int
  unitPrice   Decimal    @db.Decimal(10, 2)
  totalPrice  Decimal    @db.Decimal(12, 2)
  notes       String?

  @@map("sale_items")
}

// ─── INVENTORY ADJUSTMENT ───────────────────────────────

model InventoryAdjustment {
  id          String        @id @default(cuid())
  lotId       String
  lot         Lot           @relation(fields: [lotId], references: [id])
  type        TransactionType @default(ADJUSTMENT)
  quantity    Int           // positive = increase, negative = decrease
  reason      String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@map("inventory_adjustments")
}

// ─── SETTINGS ───────────────────────────────────────────

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("settings")
}
