{
  "extends": "next/core-web-vitals",
  "rules": {
    "@next/next/no-img-element": "error",
    "@next/next/no-html-link-for-pages": "off",
    "react/no-unescaped-entities": "error",
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  }
}
